# Build-time environment template.
#
# Values live in the deployment platform, not in the repository. Each environment
# (prod, dev, demo) sets its own values when it builds. Copy this file to `.env.local`
# only for local development.

# Branding, used by the PWA manifest and the page title.
VITE_DEFAULT_NAME=Jenesei ID
VITE_DEFAULT_NAMESHORT=Jen. ID
VITE_DEFAULT_THEME_COLOR='#ffffff'
VITE_DEFAULT_DESCRIPTION=The best service to manage your account

# Base URL of the authorization API.
VITE_BASE_URL=https://id.api.jenesei.ru

# WebSocket endpoint.
VITE_SOCKET_URL=wss://id.api.jenesei.ru

# Cookie domain shared with the core service.
VITE_CORE_URL=.jenesei.ru

# Name of the availability cookie.
VITE_AVAILABILITY_COOKIE_NAME=auth_status

# One of dev | test | prod. Controls robots meta and devtools.
VITE_NODE_ENV=dev
